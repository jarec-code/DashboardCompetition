# Copy to .env for local development. Never commit real passwords or tokens.

# --- New application (backend/) ---
# Railway sets DATABASE_URL automatically when the service references the PostgreSQL service.
DATABASE_URL=postgresql+psycopg://localhost/competition
# Required in production: a random string of at least 32 characters
# (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))").
SECRET_KEY=
# First administrator, created on deploy if no administrator exists yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Time zone for displaying and planning (stored timestamps are always UTC).
TIMEZONE=Europe/Bratislava

# --- Old Flask application (app.py), until it is retired in stage 6 ---
APP_USERNAME=admin
APP_PASSWORD=
